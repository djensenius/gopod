# Git-based Portainer stacks must define these values in the stack environment UI.
# For Web editor or Upload stacks, copy this file to .env and explicitly load it.
GOPOD_IMAGE_TAG=v0.1.0
GOPOD_CONFIG_DIR=/srv/gopod/config
GOPOD_DATA_PATH=/srv/gopod/data
GOPOD_TMP_PATH=/srv/gopod/tmp
GOPOD_UID=10001
GOPOD_GID=10001
GOPOD_STOP_GRACE_PERIOD=3h
TZ=Etc/UTC
